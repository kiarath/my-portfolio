---
/**
 * The shape the hero cursor edits: a 146×135 SVG whose path is morphed by the hero script
 * (square → heart → spark → square), with an AI-style gradient fill and Figma-like vertex handles.
 * Sized in the parent's --u units.
 */
interface Props {
  /** Unique id for the gradient (there is one shape for desktop and one for mobile). */
  id: string;
}
const { id } = Astro.props;
const handles = Array.from({ length: 8 });
---

<span class="hero-square absolute top-0 left-0" data-square aria-hidden="true">
  <svg viewBox="0 0 100 100" preserveAspectRatio="none">
    <defs>
      <linearGradient id={id} x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#ff5655" data-stop></stop>
        <stop offset="0.5" stop-color="#ff5655" data-stop></stop>
        <stop offset="1" stop-color="#ff5655" data-stop></stop>
      </linearGradient>
    </defs>
    <path
      d="M0 0H100V100H0Z"
      fill={`url(#${id})`}
      stroke="#1570ef"
      stroke-opacity="0"
      stroke-width="1"
      vector-effect="non-scaling-stroke"
      data-shape></path>
    <g opacity="0" data-handles>
      {
        handles.map(() => (
          <ellipse rx="1.6" ry="1.75" fill="#fff" stroke="#1570ef" stroke-width="1" vector-effect="non-scaling-stroke" />
        ))
      }
    </g>
  </svg>
</span>

<style>
  .hero-square {
    width: calc(146 * var(--u));
    height: calc(135 * var(--u));
    transform-origin: 0 0;
    z-index: 2;
  }
  .hero-square svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
</style>
