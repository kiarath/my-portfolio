  // layers panel
  { b: [26, 179, 83, 15], c: 'bg-[rgba(13,153,255,0.35)]' },
  { b: [31, 119, 6, 6], c: 'border border-[#9a9a9a] rounded-[1px]' },
  { b: [39, 135, 6, 6], c: 'border border-[#9a9a9a] rounded-[1px]' },
