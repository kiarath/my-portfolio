---

<div class="figma-mock relative aspect-[657/369] w-full">
  <div class="mock-inner absolute inset-0">
    <div class="absolute inset-0 overflow-hidden rounded-[4px] font-ui text-[#9a9a9a] shadow-[0_10px_40px_rgb(0_0_0/0.08)]" aria-hidden="true">
      {panels.map((p) => <span class:list={['absolute', p.c]} style={box(...p.b)} />)}
      <span class="absolute flex justify-between" style={box(10, 10, 27, 7)}>
        <i class="aspect-square h-full rounded-full bg-[#f25e50]"></i>
        <i class="aspect-square h-full rounded-full bg-[#fcb400]"></i>
        <i class="aspect-square h-full rounded-full bg-[#00bd00]"></i>
      </span>
      {
        labels.map((l) => (
          <span class:list={['absolute leading-none whitespace-pre', l.c, l.w === 'semi' && 'font-semibold']} style={`${box(l.x, l.y)};${fs(l.s)}`}>
            {l.t}
          </span>
        ))
      }
    </div>
    <slot />
  </div>
</div>

<style>
  .figma-mock {
    container-type: inline-size;
  }
  .mock-inner {
    --u: calc(100cqw / 657);
  }
</style>
