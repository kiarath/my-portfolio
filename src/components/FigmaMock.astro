  { x: 584, y: 109, s: 7, t: 'W  378', c: 'text-[#cfcfcf]' },
  { x: 622, y: 109, s: 7, t: 'H  236', c: 'text-[#cfcfcf]' },
  { x: 584, y: 126, s: 7, t: 'X  147', c: 'text-[#cfcfcf]' },
