  { b: [300, 324, 72, 12], c: 'bg-[#0d99ff] rounded-[2px]' },
  // bottom toolbar
  { b: [285, 342, 104, 20], c: 'bg-[#2c2c2c] border border-[#383838] rounded-[8px]' },
