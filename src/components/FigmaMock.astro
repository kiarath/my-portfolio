---
/**
 * The Figma window illustration used in the hero (657×369 in the design).
 * Scales to the width of its parent; children in the slot share its unit `--u`
 * (1 design px of the mock), so animated elements can be positioned in mock coordinates.
 */
const box = (x: number, y: number, w?: number, h?: number) =>
  [
    `left:calc(${x}*var(--u))`,
    `top:calc(${y}*var(--u))`,
    w !== undefined ? `width:calc(${w}*var(--u))` : '',
    h !== undefined ? `height:calc(${h}*var(--u))` : '',
  ]
    .filter(Boolean)
    .join(';');
const fs = (px: number) => `font-size:calc(${px}*var(--u))`;

// Figma UI mock (657×369) — panels and labels, positions from the design.
type Panel = { b: [number, number, number, number]; c: string };
const panels: Panel[] = [
  { b: [26, 24, 83, 345], c: 'bg-[#2c2c2c]' },
  { b: [25, 24, 84, 36], c: 'bg-[#2c2c2c] border border-[#383838]' },
  { b: [25, 59, 84, 36], c: 'bg-[#2c2c2c] border border-[#383838]' },
  { b: [25, 94, 84, 273], c: 'bg-[#2c2c2c] border border-[#383838]' },
  { b: [0, 24, 26, 345], c: 'bg-[#2c2c2c] border-r border-[#383838]' },
  { b: [109, 24, 500, 345], c: 'bg-[#1e1e1e]' },
  { b: [147, 82, 378, 236], c: 'bg-[#d9d9d9]' },
  { b: [574, 24, 83, 345], c: 'bg-[#2c2c2c]' },
