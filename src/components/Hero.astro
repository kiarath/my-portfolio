---
/**
 * Hero from Figma (Home › Frame 3) + the "Animación hero (prototipo)" sequence.
 * The stage keeps the 971×651 proportions of the design: every position uses
 * `--u` (1 design px expressed in container units), so it scales fluidly.
 */
import T from './T.astro';
import HeroCursor from './HeroCursor.astro';
import HeroShape from './HeroShape.astro';
import arrow from '../assets/icons/arrow-down.svg?raw';
import FigmaMock from './FigmaMock.astro';

/** Mobile illustration box, in px of the 375px Figma frame (`--v`). */
const vbox = (x: number, y: number, w?: number, h?: number) =>
  [
    `left:calc(${x}*var(--v))`,
    `top:calc(${y}*var(--v))`,
    w !== undefined ? `width:calc(${w}*var(--v))` : '',
    h !== undefined ? `height:calc(${h}*var(--v))` : '',
  ]
    .filter(Boolean)
    .join(';');

/** Absolute box in design px → inline style in scalable units. */
const box = (x: number, y: number, w?: number, h?: number) =>
  [
    `left:calc(${x}*var(--u))`,
    `top:calc(${y}*var(--u))`,
    w !== undefined ? `width:calc(${w}*var(--u))` : '',
    h !== undefined ? `height:calc(${h}*var(--u))` : '',
  ]
    .filter(Boolean)
    .join(';');

// Mobile: the same Swiss grid at 1:1, behind the illustration and the copy. Like on desktop, it starts at the
// text column (the 16px page margin), so the copy can sit on its lines.
const gridM = Array.from({ length: 8 }, (_, r) =>
  Array.from({ length: 5 }, (_, c) => vbox(16 + c * 79.52, r * 79.25, 96.7, 96.7)),
).flat();

// Swiss grid: 12 × 8 squares of 96.7px every 79.52px / 79.25px.
const grid = Array.from({ length: 8 }, (_, r) =>
  Array.from({ length: 12 }, (_, c) => box(c * 79.52, r * 79.25, 96.7, 96.7)),
).flat();

---

<section class="relative mx-auto max-w-[1194px] overflow-x-clip" aria-labelledby="hero-title">

  <!-- Mobile grid (Figma "A · Home (inicio)" › Frame 8): covers the whole mobile hero, illustration + copy -->
  <div class="hero-grid-m sm:hidden" aria-hidden="true">
    {gridM.map((s) => <span class="absolute border border-line opacity-40" style={s} />)}
  </div>

  <!-- Mobile illustration (Figma: "A · Home (inicio)"): zoom on the mock, 375×328 -->
  <div class="hero-m relative sm:hidden" aria-hidden="true">
    <div class="hero-m-inner">
      <span class="absolute bg-coral" style={vbox(0, 0, 72, 66)}></span>
      <div class="absolute" style={vbox(20, 69, 335)}>
        <FigmaMock>
          <div data-hero data-mode="mobile" class="absolute inset-0">
            <HeroShape id="hero-grad-m" />
            <HeroCursor />
          </div>
        </FigmaMock>
      </div>
      <span class="absolute bg-coral" style={vbox(279, 225, 48, 46)}></span>
      <span class="absolute bg-coral" style={vbox(327, 225, 48, 46)}></span>
      <span class="absolute bg-coral" style={vbox(279, 271, 48, 46)}></span>
    </div>
  </div>

  <div class="page relative sm:mt-[7px]">
    <div class="hero-container">
      <div class="hero-stage relative" data-hero data-mode="desktop">
        <!-- Grid -->
        <div class="stage-art" aria-hidden="true">
          {grid.map((s) => <span class="absolute border border-line opacity-40" style={s} />)}
        </div>

        <!-- Figma window mock -->
        <div class="stage-art absolute" style={box(398, 106, 657, 369)}><FigmaMock /></div>

        <!-- Coral blocks (Figma Home: 47,93 · 978,571 · 978,666 · 1074,761), in stage coordinates.
             The ones outside the 971px column only show where there is room for them. -->
        <span class="stage-art absolute bg-coral" style={box(-56, -17, 146, 135)} aria-hidden="true"></span>
        <span class="stage-art absolute bg-coral" style={box(875, 461, 96, 95)} aria-hidden="true"></span>
        <span class="stage-art absolute bg-coral" style={box(875, 556, 96, 95)} aria-hidden="true"></span>
        <span class="stage-art absolute bg-coral" style={box(971, 651, 96, 95)} aria-hidden="true"></span>

        <!-- Animated square + cursor (see script) -->
        <div class="stage-art" aria-hidden="true"><HeroShape id="hero-grad-d" /></div>
        <div class="stage-art" aria-hidden="true"><HeroCursor /></div>

        <!-- Copy -->
        <div class="hero-copy">
          <p class="hero-kicker lang-fade font-mono leading-[1.2]">product &amp; graphic</p>
          <h1 id="hero-title" class="hero-title leading-[1.2] font-bold">
            <T en="designer of" es="diseñadora" /><br />
            <T
              en="unique<br class='sm:hidden' /> <span class='text-gradient'>interfaces</span>"
              es="de interfaces<br class='sm:hidden' /> <span class='text-gradient'>únicas</span>"
            />
          </h1>
          <a href="#about" class="hero-scroll group inline-flex items-center gap-[calc(14*var(--u))] font-mono leading-[1.2]">
            <T en="scroll to learn more" es="scrolleá para ver más" />
            <span class="inline-block transition-transform group-hover:translate-y-0.5" set:html={arrow} />
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-container {
    container-type: inline-size;
  }
  .hero-stage {
    --u: calc(100cqw / 971);
    aspect-ratio: 971 / 651;
  }
  .hero-copy {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .hero-copy > * {
    pointer-events: auto;
  }
  .hero-kicker {
    position: absolute;
    left: calc(3 * var(--u));
    top: calc(380 * var(--u));
    font-size: max(12px, calc(16 * var(--u)));
  }
  .hero-title {
    position: absolute;
    left: calc(-2 * var(--u));
    top: calc(413 * var(--u));
    font-size: calc(64 * var(--u));
    letter-spacing: -0.01em;
  }
  .hero-scroll {
    position: absolute;
    left: 0;
    top: calc(635 * var(--u));
    font-size: max(11px, calc(13 * var(--u)));
  }

  /* Mobile (Figma "A · Home"): zoomed illustration with the copy below it, all on the 1:1 Swiss grid. */
  .hero-grid-m {
    --v: calc(100cqw / 375);
    container-type: inline-size;
    position: absolute;
    inset: 0 0 auto;
    height: calc(555 * var(--vw)); /* Figma "A · Home" › Frame 8: 375×555 with a 1px #e9e9e9 border */
    overflow: hidden;
    border: 1px solid #e9e9e9;
  }
  .hero-m {
    container-type: inline-size;
  }
  .hero-m-inner {
    --v: calc(100cqw / 375);
    position: relative;
    height: calc(317 * var(--v)); /* down to the grid line under the coral blocks */
    overflow: hidden;
  }
  section {
    --vw: calc(100vw / 375); /* 1 px of the 375px mobile frame, for the copy (its container is narrower) */
  }
  @media (max-width: 639px) {
    .stage-art {
      display: none;
    }
    .hero-stage {
      aspect-ratio: auto;
    }
    .hero-copy,
    .hero-kicker,
    .hero-title,
    .hero-scroll {
      position: static;
    }
    /* Figma "A · Home" (positions from the top of the hero box): kicker 19,326 · title 16,360 (40/40)
       · scroll 16,540. Horizontally the copy starts on the grid's first line (the 16px margin). */
    .hero-kicker {
      margin: calc(9 * var(--vw)) 0 0 3px;
      font-size: 14px;
      line-height: 21px;
    }
    .hero-title {
      margin: calc(34 * var(--vw) - 21px) 0 0 0;
      font-size: 40px;
      line-height: 40px;
    }
    .hero-scroll {
      margin: calc(180 * var(--vw) - 120px) 0 0 0;
      gap: 25px;
      font-size: 12px;
      line-height: 18px;
    }
  }
</style>

<script>
  /**
   * Hero animation. The cursor ("Kiara Correa") comes in from the right, off screen, drags the coral square into
   * the Figma canvas and edits it like a vector: square → heart → AI "spark" → gradient fill → square,
   * drags it back to the grid and leaves upwards, off screen; the next loop starts from the right again.
   * Mobile only shows the editing part, inside the canvas, and the cursor goes up and out of the canvas at the end.
   * Coordinates are in design px: the 971×651 stage (desktop) or the 657×369 mock (mobile).
   */
  type Pt = [number, number];
  type Shape = { a: Pt[]; c: [Pt, Pt][] }; // 8 anchors (TL, T, TR, R, BR, B, BL, L) + the 2 controls of each segment
  type State = { sx: number; sy: number; shape: number[]; col: number; hd: number; cx: number; cy: number };
  type Ease = (t: number) => number;
  type Step = {
    delay: number;
    dur: number;
    ease?: Ease;
    to?: Partial<Omit<State, 'cy'>> & { cy?: number | 'off' };
    /** The cursor holds this anchor while the shape morphs (vertex editing). */
    follow?: number;
    click?: boolean;
    /** Bends the cursor's path (quadratic curve): offset of the control point from the straight line's midpoint. */
    curve?: Pt;
  };

  // ── Shapes, in a 100×100 box (stretched to the 146×135 square) ──────────────────────────────
  const straight = (a: Pt[]): Shape => ({
    a,
    c: a.map((p, i) => {
      const q = a[(i + 1) % a.length];
      return [
        [p[0] + (q[0] - p[0]) / 3, p[1] + (q[1] - p[1]) / 3],
        [p[0] + (2 * (q[0] - p[0])) / 3, p[1] + (2 * (q[1] - p[1])) / 3],
      ];
    }),
  });
  const SQUARE = straight([[0, 0], [50, 0], [100, 0], [100, 50], [100, 100], [50, 100], [0, 100], [0, 50]]);
  const HEART: Shape = {
    a: [[27, 10], [50, 24], [73, 10], [97, 35], [75, 68], [50, 94], [25, 68], [3, 35]],
    c: [
      [[38, 10], [50, 16]], [[50, 16], [62, 10]], [[86, 10], [97, 20]], [[97, 50], [87, 58]],
      [[64, 78], [52, 90]], [[48, 90], [36, 78]], [[13, 58], [3, 50]], [[3, 20], [14, 10]],
    ],
  };
  const SPARK: Shape = {
    a: [[35.5, 35.5], [50, 0], [64.5, 35.5], [100, 50], [64.5, 64.5], [50, 100], [35.5, 64.5], [0, 50]],
    c: [
      [[43, 31], [48, 20]], [[52, 20], [57, 31]], [[69, 40], [80, 48]], [[80, 52], [69, 60]],
      [[57, 69], [52, 80]], [[48, 80], [43, 69]], [[31, 60], [20, 52]], [[20, 48], [31, 40]],
    ],
  };
  const nums = (s: Shape) => [...s.a.flat(), ...s.c.flat(2)];
  const sq = nums(SQUARE);
  const heart = nums(HEART);
  const spark = nums(SPARK);
  const anchor = (n: number[], i: number): Pt => [n[i * 2], n[i * 2 + 1]];
  const toPath = (n: number[]) => {
    let d = `M${n[0]} ${n[1]}`;
    for (let i = 0; i < 8; i++) {
      const c = 16 + i * 4;
      const [ax, ay] = anchor(n, (i + 1) % 8);
      d += `C${n[c]} ${n[c + 1]} ${n[c + 2]} ${n[c + 3]} ${ax} ${ay}`;
    }
    return d + 'Z';
  };

  // Fill: coral → AI gradient (cyan → violet → coral)
  const CORAL: number[] = [255, 86, 85];
  const GRADIENT: number[][] = [[1, 209, 255], [124, 92, 255], [255, 86, 85]];

  // ── Easing (CSS cubic-bezier) ───────────────────────────────────────────────────────────────
  const bezier = (x1: number, y1: number, x2: number, y2: number): Ease => {
    const cx = 3 * x1, bx = 3 * (x2 - x1) - cx, ax = 1 - cx - bx;
    const cy = 3 * y1, by = 3 * (y2 - y1) - cy, ay = 1 - cy - by;
    return (t) => {
      let s = t;
      for (let i = 0; i < 8; i++) {
        const err = ((ax * s + bx) * s + cx) * s - t;
        const d = (3 * ax * s + 2 * bx) * s + cx;
        if (Math.abs(err) < 1e-5 || Math.abs(d) < 1e-6) break;
        s -= err / d;
      }
      s = Math.min(1, Math.max(0, s));
      return ((ay * s + by) * s + cy) * s;
    };
  };
  const easeInOut = bezier(0.42, 0, 0.58, 1);
  const easeLeave = bezier(0.45, 0, 0.8, 0.6); // starts gently, speeds up as it leaves

  // ── Sequences ───────────────────────────────────────────────────────────────────────────────
  const W = 146 / 100, H = 135 / 100; // shape box → design px
  const at = (sx: number, sy: number, n: number[], i: number): Pt => {
    const [x, y] = anchor(n, i);
    return [sx + x * W, sy + y * H];
  };
  /** The editing part (shared by desktop and mobile), with the square sitting at (x, y). */
  const edit = (x: number, y: number): Step[] => {
    const [tx, ty] = at(x, y, sq, 1); // top edge
    const [hx, hy] = at(x, y, heart, 0); // heart's left lobe
    const [bx, by] = at(x, y, spark, 6); // spark's lower-left vertex
    return [
      { delay: 200, dur: 500, ease: easeInOut, to: { cx: tx, cy: ty, hd: 1 } },
      { delay: 250, dur: 900, ease: easeInOut, to: { shape: heart }, follow: 1 }, // pull the top down → heart
      { delay: 350, dur: 450, ease: easeInOut, to: { cx: hx, cy: hy } },
      { delay: 200, dur: 900, ease: easeInOut, to: { shape: spark }, follow: 0 }, // → AI spark
      { delay: 350, dur: 500, ease: easeInOut, to: { cx: x + 73, cy: y + 67.5, hd: 0 } },
      { delay: 150, dur: 800, ease: easeInOut, to: { col: 1 }, click: true }, // gradient fill
      { delay: 450, dur: 600, ease: easeInOut, to: { cx: bx, cy: by, hd: 1 } },
      { delay: 200, dur: 900, ease: easeInOut, to: { shape: sq, col: 0 }, follow: 6 }, // back to a square
    ];
  };

  const S0: Pt = [141, 147]; // square on the grid
  const S1: Pt = [661, 239]; // square in the Figma canvas
  const G: Pt = [86, 50]; // where the cursor grabs it
  const desktop: { init: State; steps: Step[] } = {
    init: { sx: S0[0], sy: S0[1], shape: sq, col: 0, hd: 0, cx: 0, cy: 260 }, // cursor starts off screen, right
    steps: [
      { delay: 400, dur: 1500, ease: easeInOut, to: { cx: S0[0] + G[0], cy: S0[1] + G[1] }, curve: [0, -45] }, // comes in from the right
      { delay: 250, dur: 1000, ease: easeInOut, to: { sx: S1[0], sy: S1[1], cx: S1[0] + G[0], cy: S1[1] + G[1] } },
      ...edit(S1[0], S1[1]),
      { delay: 250, dur: 400, ease: easeInOut, to: { cx: S1[0] + G[0], cy: S1[1] + G[1], hd: 0 } },
      { delay: 150, dur: 1100, ease: easeInOut, to: { sx: S0[0], sy: S0[1], cx: S0[0] + G[0], cy: S0[1] + G[1] } },
      { delay: 300, dur: 1100, ease: easeLeave, to: { cx: S0[0] + G[0] + 80, cy: 'off' }, curve: [120, 70] }, // leaves the square, curving up and off screen
      { delay: 900, dur: 0 },
    ],
  };
  const M: Pt = [S1[0] - 398, S1[1] - 106]; // same spot, in mock coordinates
  const mobile: { init: State; steps: Step[] } = {
    init: { sx: M[0], sy: M[1], shape: sq, col: 0, hd: 0, cx: 0, cy: 190 }, // cursor starts off canvas, right
    steps: [
      ...edit(M[0], M[1]).map((st, i) => (i === 0 ? { ...st, delay: 400, dur: 1200, ease: easeInOut, curve: [0, -25] as Pt } : st)),
      { delay: 250, dur: 1000, ease: easeLeave, to: { cx: M[0] + 60, cy: 'off', hd: 0 }, curve: [130, 60] }, // curves up, out of the canvas
      { delay: 900, dur: 0 },
    ],
  };

  // ── Player ──────────────────────────────────────────────────────────────────────────────────
  const u = (n: number) => `calc(${n} * var(--u))`;
  const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLElement>('[data-hero]').forEach((stage) => {
    const square = stage.querySelector<HTMLElement>('[data-square]');
    const cursor = stage.querySelector<HTMLElement>('[data-cursor]');
    const path = square?.querySelector<SVGPathElement>('[data-shape]');
    const handles = square?.querySelector<SVGGElement>('[data-handles]');
    if (!square || !cursor || !path || !handles) return;
    const dots = [...handles.children] as SVGEllipseElement[];
    const stops = [...square.querySelectorAll<SVGStopElement>('[data-stop]')];
    const seq = stage.dataset.mode === 'mobile' ? mobile : desktop;

    // The hero section clips horizontally: the visible edge is the section's or the viewport's, whichever is closer.
    const unit = () => cursor.offsetWidth / 150; // px per design px
    const edge = () =>
      Math.min(document.documentElement.clientWidth, stage.closest('section')?.getBoundingClientRect().right ?? Infinity);
    const left = () => stage.getBoundingClientRect().left;
    /** The "Kiara Correa" tag always stays right of the arrow: on narrow screens the cursor stops a bit earlier. */
    const limit = (cx: number) => Math.min(cx, (edge() - 8 - left()) / unit() - 143);
    /** Fully outside the visible area, to the right. */
    const offX = () => (edge() - left()) / unit() + 30;
    /** Fully above the visible area: the top of the screen (desktop, under the header) or of the mobile canvas. */
    const offY = () => {
      const top = stage.closest<HTMLElement>('.hero-m-inner')?.getBoundingClientRect().top ?? 0;
      return (top - stage.getBoundingClientRect().top) / unit() - 70;
    };

    const render = (s: State) => {
      square.style.transform = `translate(${u(s.sx)}, ${u(s.sy)})`;
      path.setAttribute('d', toPath(s.shape));
      path.setAttribute('stroke-opacity', String(s.hd));
      handles.setAttribute('opacity', String(s.hd));
      dots.forEach((dot, i) => {
        const [x, y] = anchor(s.shape, i);
        dot.setAttribute('cx', String(x));
        dot.setAttribute('cy', String(y));
      });
      stops.forEach((stop, i) => {
        const rgb = CORAL.map((c, k) => Math.round(lerp(c, GRADIENT[i][k], s.col)));
        stop.setAttribute('stop-color', `rgb(${rgb.join(' ')})`);
      });
      cursor.style.transform = `translate(${u(s.cx)}, ${u(s.cy)})`;
    };

    let cur: State = { ...seq.init, cx: offX() };
    if (reduced) {
      const [x, y] = at(cur.sx, cur.sy, sq, 1);
      render({ ...cur, cx: limit(x + 20), cy: y + 40 });
      return;
    }
    render(cur);

    let visible = true;
    new IntersectionObserver(([entry]) => (visible = entry.isIntersecting)).observe(stage);
    // Only the version shown for this screen size animates (the other one is display:none).
    const active = () => visible && !document.hidden && square.offsetParent !== null;
    const frame = () => new Promise<number>((r) => requestAnimationFrame(r));
    /** Waits `ms` of *visible* time, calling `tick(progress)` every frame. */
    const elapse = async (ms: number, tick?: (t: number) => void) => {
      let t = 0;
      let last = await frame();
      while (t < ms) {
        const now = await frame();
        if (active()) t += Math.min(now - last, 50);
        last = now;
        tick?.(Math.min(1, t / ms));
      }
      tick?.(1);
    };
    const press = () => {
      cursor.classList.add('is-press');
      setTimeout(() => cursor.classList.remove('is-press'), 180);
    };

    const play = async (step: Step) => {
      await elapse(step.delay);
      const from = cur;
      const to = step.to ?? {};
      const end = {
        sx: to.sx ?? from.sx,
        sy: to.sy ?? from.sy,
        shape: to.shape ?? from.shape,
        col: to.col ?? from.col,
        hd: to.hd ?? from.hd,
        cx: to.cx !== undefined ? limit(to.cx) : from.cx,
        cy: to.cy === 'off' ? offY() : (to.cy ?? from.cy),
      };
      if (step.click) press();
      const ease = step.ease ?? easeInOut;
      await elapse(step.dur, (t) => {
        const k = ease(t);
        const s: State = {
          sx: lerp(from.sx, end.sx, k),
          sy: lerp(from.sy, end.sy, k),
          shape: from.shape.map((v, i) => lerp(v, end.shape[i], k)),
          col: lerp(from.col, end.col, k),
          hd: lerp(from.hd, end.hd, k),
          cx: lerp(from.cx, end.cx, k),
          cy: lerp(from.cy, end.cy, k),
        };
        if (step.curve) {
          // quadratic Bézier through a control point beside the straight line → a natural, slightly curved path
          const qx = (from.cx + end.cx) / 2 + step.curve[0];
          const qy = (from.cy + end.cy) / 2 + step.curve[1];
          s.cx = (1 - k) ** 2 * from.cx + 2 * (1 - k) * k * qx + k ** 2 * end.cx;
          s.cy = (1 - k) ** 2 * from.cy + 2 * (1 - k) * k * qy + k ** 2 * end.cy;
        }
        if (step.follow !== undefined) {
          const [x, y] = at(s.sx, s.sy, s.shape, step.follow);
          s.cx = limit(x);
          s.cy = y;
        }
        cur = s;
        render(s);
      });
    };

    (async () => {
      for (;;) {
        for (const step of seq.steps) await play(step);
        cur = { ...seq.init, cx: offX() }; // each loop starts with the cursor coming in from the right
        render(cur);
      }
    })();
  });
</script>
