---
/** Segmented control "Español | English" (desktop) / "ES | EN" (mobile), from the Figma header. */
---

<div
  class="lang-toggle relative flex h-6 w-[76px] rounded-[5px] bg-toggle p-0.5 sm:w-[162px]"
  role="group"
  aria-label="Language / Idioma"
  data-lang-toggle
>
  <span class="lang-pill" aria-hidden="true"></span>
  <button type="button" data-set-lang="es" class="lang-btn" lang="es" aria-label="Español"
    ><span class="sm:hidden">ES</span><span class="max-sm:hidden">Español</span></button
  >
  <button type="button" data-set-lang="en" class="lang-btn" lang="en" aria-label="English"
    ><span class="sm:hidden">EN</span><span class="max-sm:hidden">English</span></button
  >
</div>

<style>
  .lang-btn {
    position: relative;
    z-index: 1;
    flex: 1;
    border-radius: 4px;
    font-size: 11px;
    line-height: 1;
    color: #555;
    cursor: pointer;
  }
  @media (min-width: 640px) {
    .lang-btn {
      border-radius: 5px;
      font-size: 12px;
      color: #000;
    }
  }
  /* White pill that slides between the two options (Figma motion: translate 78px, 0.356s linear).
     It follows the click right away (data-active); before JS runs it follows <html data-lang>. */
  .lang-pill {
    position: absolute;
    top: 2px;
    bottom: 2px;
    left: 2px;
    width: calc(50% - 2px);
    border-radius: 4px;
    background: #fefefe;
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.06);
    transform: translateX(calc(100% - 1px));
    transition: transform 0.356s linear;
  }
  @media (min-width: 640px) {
    .lang-pill {
      border-radius: 5px;
    }
  }
  :global(html[data-lang='es']) .lang-toggle:not([data-active]) .lang-pill,
  .lang-toggle[data-active='es'] .lang-pill {
    transform: translateX(0);
  }
  :global(html:not([data-lang='es'])) .lang-toggle:not([data-active]) .lang-btn[data-set-lang='en'],
  :global(html[data-lang='es']) .lang-toggle:not([data-active]) .lang-btn[data-set-lang='es'],
  .lang-toggle[data-active='en'] .lang-btn[data-set-lang='en'],
  .lang-toggle[data-active='es'] .lang-btn[data-set-lang='es'] {
    color: #000;
    font-weight: 500;
  }
</style>

<script>
  const root = document.documentElement;
  const FADE_MS = 300; // Figma: Home → Home smart animate, 0.3s ease-out
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
  const toggle = document.querySelector<HTMLElement>('[data-lang-toggle]');
  toggle?.setAttribute('data-active', root.dataset.lang === 'es' ? 'es' : 'en');
  let timer: number | undefined;

  const apply = (lang: string) => {
    root.dataset.lang = lang;
    root.lang = lang;
    try {
      localStorage.setItem('lang', lang);
    } catch {}
  };

  document.querySelectorAll<HTMLButtonElement>('[data-set-lang]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const lang = btn.dataset.setLang === 'es' ? 'es' : 'en';
      const busy = root.classList.contains('lang-out') || root.classList.contains('lang-in');
      if (!busy && lang === (root.dataset.lang === 'es' ? 'es' : 'en')) return;
      toggle?.setAttribute('data-active', lang); // the pill starts sliding right away
      clearTimeout(timer);
      root.classList.remove('lang-out', 'lang-in');
      if (reduced.matches) return apply(lang);
      // fade the text out → swap the language while it is invisible → fade it back in
      root.classList.add('lang-out');
      timer = window.setTimeout(() => {
        apply(lang);
        root.classList.replace('lang-out', 'lang-in');
        timer = window.setTimeout(() => root.classList.remove('lang-in'), FADE_MS);
      }, FADE_MS);
    });
  });
</script>
