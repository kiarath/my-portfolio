---
/** Segmented control "Español | English" (desktop) / "ES | EN" (mobile), from the Figma header. */
---

<div class="flex h-6 w-[76px] rounded-[5px] bg-toggle p-0.5 sm:w-[162px]" role="group" aria-label="Language / Idioma">
  <button type="button" data-set-lang="es" class="lang-btn" lang="es" aria-label="Español"
    ><span class="sm:hidden">ES</span><span class="max-sm:hidden">Español</span></button
  >
  <button type="button" data-set-lang="en" class="lang-btn" lang="en" aria-label="English"
    ><span class="sm:hidden">EN</span><span class="max-sm:hidden">English</span></button
  >
</div>

<style>
  .lang-btn {
    flex: 1;
    border-radius: 4px;
    font-size: 11px;
    line-height: 1;
    color: #555;
    cursor: pointer;
    transition: background-color 0.2s;
  }
  @media (min-width: 640px) {
    .lang-btn {
      border-radius: 5px;
      font-size: 12px;
      color: #000;
    }
  }
  :global(html:not([data-lang='es'])) .lang-btn[data-set-lang='en'],
  :global(html[data-lang='es']) .lang-btn[data-set-lang='es'] {
    background: #fefefe;
    color: #000;
    font-weight: 500;
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.06);
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-set-lang]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const lang = btn.dataset.setLang === 'es' ? 'es' : 'en';
      document.documentElement.dataset.lang = lang;
      document.documentElement.lang = lang;
      try {
        localStorage.setItem('lang', lang);
      } catch {}
    });
  });
</script>
