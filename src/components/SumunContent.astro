---
import BaseLayout from '../layouts/BaseLayout.astro';
import CaseStudyHero from './CaseStudyHero.astro';
import { translations } from '../data/translations';

interface Props {
  lang: 'en' | 'es';
}

const { lang } = Astro.props;
const t = translations.sumun[lang];
const tShared = translations.shared[lang];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout
  title={t.pageTitle}
  description={t.pageDesc}
  lang={lang}
  currentPath={lang === 'es' ? '/es/sumun/' : '/sumun/'}
  isCaseStudy={true}
  image={`${base}/images/sumun-home.webp`}
>
  <CaseStudyHero
    title={t.heroTitle}
    description={t.heroDesc}
    role={t.roleValue}
    timeline={t.timelineValue}
    tools={t.toolsValue}
    badges={['Web', 'Responsive', 'EdTech', 'AI', 'Figma']}
    bannerSrc={`${base}/images/sumun-home.webp`}
    bannerAlt="Sumun website – Home"
    roleLabel={tShared.role}
    timelineLabel={tShared.timeline}
    toolsLabel={tShared.tools}
    // No behance URL for this case study
  />

  <div class="cs-content">
    <!-- What is Sumun -->
    <div class="cs-section reveal">
      <div class="card card--tc">
        <h2 style="color:var(--tc-600);margin-bottom:.75rem;font-weight:700;">{t.s_whatIsTitle}</h2>
        <p style="color:var(--gray-700);line-height:1.7;">{t.s_whatIsBody}</p>
      </div>
    </div>

    <!-- Why Native (Design Challenge) -->
    <div class="cs-section reveal">
      <div class="card card--tc">
        <h2 style="color:var(--tc-600);margin-bottom:.75rem;font-weight:700;">{t.s_challengeTitle}</h2>
        <p style="color:var(--gray-700);line-height:1.7;">{t.s_challengeBody}</p>
      </div>
    </div>

    <!-- Context / Problem -->
    <div class="cs-section reveal">
      <div class="grid-2">
        <div class="card card--hoverable" style="border-left:4px solid #16a34a;"
          onmouseenter="this.style.transform='scale(1.03)';this.style.boxShadow='0 8px 24px rgba(0,0,0,.12)'"
          onmouseleave="this.style.transform='';this.style.boxShadow=''"><h2 style="color:var(--tc-600);margin-bottom:.75rem;">{t.s_contextTitle}</h2>
          <p style="color:var(--gray-700);line-height:1.7;">{t.s_contextBody}</p>
        </div>
        <div class="card card--hoverable" style="border-left:4px solid #dc2626;"
          onmouseenter="this.style.transform='scale(1.03)';this.style.boxShadow='0 8px 24px rgba(0,0,0,.12)'"
          onmouseleave="this.style.transform='';this.style.boxShadow=''"><h2 style="color:var(--tc-600);margin-bottom:.75rem;">{t.s_problemTitle}</h2>
          <p style="color:var(--gray-700);line-height:1.7;">{t.s_problemBody}</p>
        </div>
      </div>
    </div>

    <!-- 01. Audience -->
    <div class="cs-section reveal">
      <div class="cs-section-title">
        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m21 21-4.34-4.34"/><circle cx="11" cy="11" r="8"/>
        </svg>
        <span>{t.s_researchTitle}</span>
      </div>
      <p style="color:var(--gray-700);margin-bottom:1.5rem;line-height:1.7;">{t.s_researchIntro}</p>
      <div class="grid-2">
        <div class="card card--tc"><h4 style="color:var(--tc-600);margin-bottom:.35rem;">{t.aud1Title}</h4>
          <p style="color:var(--gray-700);line-height:1.7;">{t.aud1Desc}</p></div>
        <div class="card card--tc"><h4 style="color:var(--tc-600);margin-bottom:.35rem;">{t.aud2Title}</h4>
          <p style="color:var(--gray-700);line-height:1.7;">{t.aud2Desc}</p></div>
        <div class="card card--tc"><h4 style="color:var(--tc-600);margin-bottom:.35rem;">{t.aud3Title}</h4>
          <p style="color:var(--gray-700);line-height:1.7;">{t.aud3Desc}</p></div>
        <div class="card card--tc"><h4 style="color:var(--tc-600);margin-bottom:.35rem;">{t.aud4Title}</h4>
          <p style="color:var(--gray-700);line-height:1.7;">{t.aud4Desc}</p></div>
      </div>
    </div>

    <!-- 02. Requirements -->
    <div class="cs-section reveal">
      <div class="cs-section-title">
        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/>
          <path d="M14 2v4a2 2 0 0 0 2 2h4"/>
          <path d="M10 9H8"/>
          <path d="M16 13H8"/>
          <path d="M16 17H8"/>
        </svg>
        <span>{t.s_reqTitle}</span>
      </div>
      <div class="card card--highlight" style="margin-bottom:1rem;">
        <h3 style="color:var(--tc-600);margin-bottom:.5rem;">{t.primaryObj}</h3>
        <p style="color:var(--gray-700);line-height:1.7;">{t.primaryObjBody}</p>
      </div>
      <div class="card card--tc" style="margin-bottom:1.5rem;">
        <h3 style="color:var(--tc-600);margin-bottom:.5rem;">{t.secondaryObj}</h3>
        <p style="color:var(--gray-700);line-height:1.7;">{t.secondaryObjBody}</p>
      </div>
      <h3 style="color:var(--tc-600);margin-bottom:1rem;">{t.s_keyNeeds}</h3>
      <div class="grid-2">
        <div class="card" style="border-left:4px solid var(--tc-600);"><h4 style="color:var(--tc-600);margin-bottom:.35rem;">{t.need1Title}</h4>
          <p style="color:var(--gray-700);">{t.need1Desc}</p></div>
        <div class="card" style="border-left:4px solid var(--tc-600);"><h4 style="color:var(--tc-600);margin-bottom:.35rem;">{t.need2Title}</h4>
          <p style="color:var(--gray-700);">{t.need2Desc}</p></div>
        <div class="card" style="border-left:4px solid var(--tc-600);"><h4 style="color:var(--tc-600);margin-bottom:.35rem;">{t.need3Title}</h4>
          <p style="color:var(--gray-700);">{t.need3Desc}</p></div>
        <div class="card" style="border-left:4px solid var(--tc-600);"><h4 style="color:var(--tc-600);margin-bottom:.35rem;">{t.need4Title}</h4>
          <p style="color:var(--gray-700);">{t.need4Desc}</p></div>
      </div>
    </div>

    <!-- 03. Structure & Design System -->
    <div class="cs-section reveal">
      <div class="cs-section-title">
        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83z"/>
          <path d="M2 12a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 12"/>
          <path d="M2 17a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 17"/>
        </svg>
        <span>{t.s_dsTitle}</span>
      </div>
      <h3 style="color:var(--tc-600);margin-bottom:1rem;">{t.s_archTitle}</h3>
      <p style="color:var(--gray-700);margin-bottom:1.25rem;line-height:1.7;">{t.s_archBody}</p>
      <div class="grid-4" style="margin-bottom:2rem;">
        <div class="card card--tc"><h4 style="color:var(--tc-600);margin-bottom:.35rem;">{t.arch1Title}</h4>
          <p style="color:var(--gray-700);font-size:.9rem;">{t.arch1Desc}</p></div>
        <div class="card card--tc"><h4 style="color:var(--tc-600);margin-bottom:.35rem;">{t.arch2Title}</h4>
          <p style="color:var(--gray-700);font-size:.9rem;">{t.arch2Desc}</p></div>
        <div class="card card--tc"><h4 style="color:var(--tc-600);margin-bottom:.35rem;">{t.arch3Title}</h4>
          <p style="color:var(--gray-700);font-size:.9rem;">{t.arch3Desc}</p></div>
        <div class="card card--tc"><h4 style="color:var(--tc-600);margin-bottom:.35rem;">{t.arch4Title}</h4>
          <p style="color:var(--gray-700);font-size:.9rem;">{t.arch4Desc}</p></div>
      </div>

      <h3 style="color:var(--tc-600);margin-bottom:1rem;">{t.s_dsNewTitle}</h3>
      <p style="color:var(--gray-700);margin-bottom:1.25rem;line-height:1.7;">{t.s_dsNewBody}</p>

      <div style="display:flex;flex-direction:column;gap:1rem;margin-bottom:1.5rem;">
        <div class="card card--tc"><h4 style="color:var(--tc-600);margin-bottom:.75rem;">{t.s_colorTitle}</h4>
          <div class="grid-2"><div><p style="font-size:.8125rem;color:var(--gray-600);margin-bottom:.5rem;">{t.s_primaryColors}</p>
            <div style="display:flex;gap:.5rem;"><div class="swatch" style="background:#003d4c;" title="#003D4C"></div><div class="swatch" style="background:#0095cd;" title="#0095CD"></div></div></div>
            <div><p style="font-size:.8125rem;color:var(--gray-600);margin-bottom:.5rem;">{t.s_secondaryColors}</p>
            <div style="display:flex;gap:.5rem;"><div class="swatch" style="background:#f15a2e;" title="#F15A2E"></div><div class="swatch" style="background:#ff6306;" title="#FF6306"></div><div class="swatch" style="background:#006678;" title="#006678"></div></div></div></div></div>
        <div class="card card--tc"><h4 style="color:var(--tc-600);margin-bottom:.75rem;">{t.s_typoTitle}</h4>
          <ul style="color:var(--gray-700);line-height:2;"><li>• <strong>Manrope</strong> <span>{t.s_typoPrimary}</span></li>
            <li>• <strong>Figtree</strong> <span>{t.s_typoSecondary}</span></li></ul></div>
        <div class="card card--tc"><h4 style="color:var(--tc-600);margin-bottom:.75rem;">{t.s_compTitle}</h4>
          <div class="grid-2" style="color:var(--gray-700);line-height:2;">
            <div>{t.comp1}</div>
            <div>{t.comp2}</div>
            <div>{t.comp3}</div>
            <div>{t.comp4}</div>
            <div>{t.comp5}</div>
            <div>{t.comp6}</div>
            <div>{t.comp7}</div>
            <div>{t.comp8}</div>
          </div></div>
      </div>
    </div>

    <!-- 04. Iteration & Responsive Review -->
    <div class="cs-section reveal">
      <div class="cs-section-title">
        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="10"/>
          <path d="m9 12 2 2 4-4"/>
        </svg>
        <span>{t.iterTitle}</span>
      </div>
      <p style="color:var(--gray-700);margin-bottom:1.5rem;line-height:1.7;">{t.iterIntro}</p>
      <div style="display:flex;flex-direction:column;gap:1rem;margin-bottom:1.5rem;">
        <div class="card card--tc"><h4 style="color:var(--tc-600);margin-bottom:.35rem;">{t.iter1Title}</h4>
          <p style="color:var(--gray-700);line-height:1.7;">{t.iter1Desc}</p></div>
        <div class="card card--tc"><h4 style="color:var(--tc-600);margin-bottom:.35rem;">{t.iter2Title}</h4>
          <p style="color:var(--gray-700);line-height:1.7;">{t.iter2Desc}</p></div>
        <div class="card card--tc"><h4 style="color:var(--tc-600);margin-bottom:.35rem;">{t.iter3Title}</h4>
          <p style="color:var(--gray-700);line-height:1.7;">{t.iter3Desc}</p></div>
        <div class="card card--highlight"><h4 style="color:var(--tc-600);margin-bottom:.35rem;">{t.iter4Title}</h4>
          <p style="color:var(--gray-700);line-height:1.7;">{t.iter4Desc}</p></div>
      </div>
    </div>

    <!-- 05. Final Solution -->
    <div class="cs-section reveal">
      <div class="cs-section-title">
        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5"/>
          <path d="M9 18h6"/><path d="M10 22h4"/>
        </svg>
        <span>{t.finalTitle}</span>
      </div>
      <p style="color:var(--gray-700);line-height:1.7;margin-bottom:1.5rem;">{t.finalBody}</p>
      <div class="card card--highlight" style="margin-bottom:1.5rem;">
        <h3 style="color:var(--tc-600);margin-bottom:1rem;">{t.keyFeatures}</h3>
        <div class="grid-2">
          <div><h4 style="color:var(--tc-600);margin-bottom:.35rem;">{t.feat1Title}</h4><p style="color:var(--gray-700);">{t.feat1Desc}</p></div>
          <div><h4 style="color:var(--tc-600);margin-bottom:.35rem;">{t.feat2Title}</h4><p style="color:var(--gray-700);">{t.feat2Desc}</p></div>
          <div><h4 style="color:var(--tc-600);margin-bottom:.35rem;">{t.feat3Title}</h4><p style="color:var(--gray-700);">{t.feat3Desc}</p></div>
          <div><h4 style="color:var(--tc-600);margin-bottom:.35rem;">{t.feat4Title}</h4><p style="color:var(--gray-700);">{t.feat4Desc}</p></div>
        </div>
      </div>
    </div>

    <!-- Deliverables -->
    <div class="cs-section reveal">
      <div class="cs-section-title"><svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none"
          stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 7h6v6"/>
          <path d="m22 7-8.5 8.5-5-5L2 17"/></svg><span>{t.s_impactTitle}</span></div>
      <div class="card" style="background:linear-gradient(135deg,var(--tc-50),var(--tc-100));border-color:var(--tc-200);padding:2rem;">
        <div class="grid-3">
          <div style="text-align:center;"><svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none"
            stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color:var(--tc-600);margin:0 auto 1rem;">
            <path d="M12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83z"/>
            <path d="M2 12a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 12"/>
          </svg>
          <div style="color:var(--tc-600);margin-bottom:.5rem;font-weight:600;">{t.imp1Label}</div>
          <p style="color:var(--gray-600);font-size:.875rem;">{t.imp1Desc}</p></div>
          <div style="text-align:center;"><svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none"
            stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color:var(--tc-600);margin:0 auto 1rem;">
            <rect width="14" height="20" x="5" y="2" rx="2" ry="2"/>
            <path d="M12 18h.01"/>
          </svg>
          <div style="color:var(--tc-600);margin-bottom:.5rem;font-weight:600;">{t.imp2Label}</div>
          <p style="color:var(--gray-600);font-size:.875rem;">{t.imp2Desc}</p></div>
          <div style="text-align:center;"><svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none"
            stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color:var(--tc-600);margin:0 auto 1rem;">
            <path d="M11 21.73a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73z"/>
            <path d="M12 22V12"/>
            <polyline points="3.29 7 12 12 20.71 7"/>
            <path d="m7.5 4.27 9 5.15"/>
          </svg>
          <div style="color:var(--tc-600);margin-bottom:.5rem;font-weight:600;">{t.imp3Label}</div>
          <p style="color:var(--gray-600);font-size:.875rem;">{t.imp3Desc}</p></div>
        </div>
      </div>
    </div>

    <div class="cs-section reveal" style="text-align:center;padding-bottom:4rem;">
      <a href="index.html#work" class="btn btn--primary btn--lg"><span>{tShared.backToPortfolio}</span></a>
    </div>
  </div>
</BaseLayout>
