---
import BaseLayout from '../layouts/BaseLayout.astro';
import CaseStudyHero from './CaseStudyHero.astro';
import { translations } from '../data/translations';

interface Props {
  lang: 'en' | 'es';
}

const { lang } = Astro.props;
const t = translations.jodify[lang];
const tShared = translations.shared[lang];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout
  title={t.pageTitle}
  description={t.pageDesc}
  lang={lang}
  currentPath={lang === 'es' ? '/es/jodify/' : '/jodify/'}
  isCaseStudy={true}
  image={`${base}/images/98a6b03f15da70021a3c30ca67eb0fb7d5b2e5d9.avif`}
>
  <CaseStudyHero
    title={t.heroTitle}
    description={t.heroDesc}
    role={t.roleValue}
    timeline={t.timelineValue}
    tools={t.toolsValue}
    badges={['iOS', 'Android', 'Mobile App', 'Entertainment', 'Figma']}
    bannerSrc={`${base}/images/98a6b03f15da70021a3c30ca67eb0fb7d5b2e5d9.avif`}
    bannerAlt="Jodify App Preview"
    roleLabel={tShared.role}
    timelineLabel={tShared.timeline}
    toolsLabel={tShared.tools}
    behanceUrl={t.behanceUrl}
    behanceLabel={tShared.viewOnBehance}
  />

  <div class="cs-content">
    <!-- What is Jodify -->
    <div class="cs-section reveal">
      <div class="card card--tc">
        <h2 style="color:var(--tc-600);margin-bottom:.75rem;font-weight:700;">{t.whatIsTitle}</h2>
        <p style="color:var(--gray-700);line-height:1.7;">{t.whatIsBody}</p>
      </div>
    </div>

    <!-- Why Native -->
    <div class="cs-section reveal">
      <div class="card card--tc">
        <h2 style="color:var(--tc-600);margin-bottom:.75rem;font-weight:700;">{t.whyNativeTitle}</h2>
        <p style="color:var(--gray-700);line-height:1.7;">{t.whyNativeBody}</p>
      </div>
    </div>

    <!-- Context / Problem -->
    <div class="cs-section reveal">
      <div class="grid-2">
        <div class="card card--hoverable" style="border-left:4px solid #16a34a;">
          <h2 style="color:var(--tc-600);margin-bottom:.75rem;">{t.contextTitle}</h2>
          <p style="color:var(--gray-700);line-height:1.7;">{t.contextBody}</p>
        </div>
        <div class="card card--hoverable" style="border-left:4px solid #dc2626;">
          <h2 style="color:var(--tc-600);margin-bottom:.75rem;">{t.problemTitle}</h2>
          <p style="color:var(--gray-700);line-height:1.7;">{t.problemBody}</p>
        </div>
      </div>
    </div>

    <!-- 01. User Research -->
    <div class="cs-section reveal">
      <div class="cs-section-title">
        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m21 21-4.34-4.34"/><circle cx="11" cy="11" r="8"/>
        </svg>
        <span>{t.researchTitle}</span>
      </div>
      <p style="color:var(--gray-700);margin-bottom:1.5rem;" set:html={t.researchIntro}></p>

      <div class="card card--tc">
        <h3 style="color:var(--tc-600);margin-bottom:1rem;">{t.meetMartina}</h3>
        <div style="display:flex;flex-wrap:wrap;gap:1rem;color:var(--gray-600);margin-bottom:1rem;font-size:.9rem;" set:html={t.martinaDetails}></div>
        <p style="color:var(--gray-700);line-height:1.7;margin-bottom:1.5rem;">{t.martinaBody}</p>
        <div class="grid-2">
          <div>
            <h4 style="color:var(--tc-600);margin-bottom:.5rem;">{t.motivationsLabel}</h4>
            <ul style="color:var(--gray-700);line-height:2;">
              {t.motivationsList.map((item) => <li>• {item}</li>)}
            </ul>
          </div>
          <div>
            <h4 style="color:var(--tc-600);margin-bottom:.5rem;">{t.frustrationsLabel}</h4>
            <ul style="color:var(--gray-700);line-height:2;">
              {t.frustrationsList.map((item) => <li>• {item}</li>)}
            </ul>
          </div>
        </div>
      </div>
    </div>

    <!-- 02. Requirements -->
    <div class="cs-section reveal">
      <div class="cs-section-title">
        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/>
          <path d="M14 2v4a2 2 0 0 0 2 2h4"/>
          <path d="M10 9H8"/><path d="M16 13H8"/><path d="M16 17H8"/>
        </svg>
        <span>{t.reqTitle}</span>
      </div>

      <div class="card card--highlight" style="margin-bottom:1rem;">
        <h3 style="color:var(--tc-600);margin-bottom:.5rem;">{t.primaryObj}</h3>
        <p style="color:var(--gray-700);line-height:1.7;">{t.primaryObjBody}</p>
      </div>
      <div class="card card--tc" style="margin-bottom:1.5rem;">
        <h3 style="color:var(--tc-600);margin-bottom:.5rem;">{t.secondaryObj}</h3>
        <p style="color:var(--gray-700);line-height:1.7;">{t.secondaryObjBody}</p>
      </div>

      <h3 style="color:var(--tc-600);margin-bottom:1rem;">{t.keyNeeds}</h3>
      <div class="grid-2">
        <div class="card" style="border-left:4px solid var(--tc-600);">
          <h4 style="color:var(--tc-600);margin-bottom:.35rem;">{t.needSpeed}</h4>
          <p style="color:var(--gray-700);">{t.needSpeedDesc}</p>
        </div>
        <div class="card" style="border-left:4px solid var(--tc-600);">
          <h4 style="color:var(--tc-600);margin-bottom:.35rem;">{t.needFilter}</h4>
          <p style="color:var(--gray-700);">{t.needFilterDesc}</p>
        </div>
        <div class="card" style="border-left:4px solid var(--tc-600);">
          <h4 style="color:var(--tc-600);margin-bottom:.35rem;">{t.needLocation}</h4>
          <p style="color:var(--gray-700);">{t.needLocationDesc}</p>
        </div>
        <div class="card" style="border-left:4px solid var(--tc-600);">
          <h4 style="color:var(--tc-600);margin-bottom:.35rem;">{t.needNative}</h4>
          <p style="color:var(--gray-700);">{t.needNativeDesc}</p>
        </div>
      </div>
    </div>

    <!-- 03. Structure & Design System -->
    <div class="cs-section reveal">
      <div class="cs-section-title">
        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83z"/>
          <path d="M2 12a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 12"/>
          <path d="M2 17a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 17"/>
        </svg>
        <span>{t.dsTitle}</span>
      </div>

      <h3 style="color:var(--tc-600);margin-bottom:1rem;">{t.analysisTitle}</h3>
      <p style="color:var(--gray-700);margin-bottom:1.25rem;line-height:1.7;">{t.analysisBody}</p>
      <div class="grid-4" style="margin-bottom:2rem;">
        <div class="card card--tc" style="text-align:center;"><p style="color:var(--gray-700);font-weight:600;">Branding</p></div>
        <div class="card card--tc" style="text-align:center;"><p style="color:var(--gray-700);font-weight:600;">Search &amp; Filters</p></div>
        <div class="card card--tc" style="text-align:center;"><p style="color:var(--gray-700);font-weight:600;">Dates</p></div>
        <div class="card card--tc" style="text-align:center;"><p style="color:var(--gray-700);font-weight:600;">Events</p></div>
      </div>

      <h3 style="color:var(--tc-600);margin-bottom:1rem;">{t.dsNewTitle}</h3>
      <p style="color:var(--gray-700);margin-bottom:1.25rem;line-height:1.7;">{t.dsNewBody}</p>

      <div style="display:flex;flex-direction:column;gap:1rem;margin-bottom:1.5rem;">
        <div class="card card--tc">
          <h4 style="color:var(--tc-600);margin-bottom:.75rem;">{t.colorPalette}</h4>
          <div class="grid-2">
            <div>
              <p style="font-size:.8125rem;color:var(--gray-600);margin-bottom:.5rem;">{t.primaryColors}</p>
              <div style="display:flex;gap:.5rem;">
                <div class="swatch" style="background:#7c3aed;"></div>
                <div class="swatch" style="background:#4b5563;"></div>
              </div>
            </div>
            <div>
              <p style="font-size:.8125rem;color:var(--gray-600);margin-bottom:.5rem;">{t.secondaryColors}</p>
              <div style="display:flex;gap:.5rem;">
                <div class="swatch" style="background:#eab308;"></div>
                <div class="swatch" style="background:#22c55e;"></div>
                <div class="swatch" style="background:#f97316;"></div>
              </div>
            </div>
          </div>
        </div>
        <div class="card card--tc">
          <h4 style="color:var(--tc-600);margin-bottom:.75rem;">{t.typography}</h4>
          <ul style="color:var(--gray-700);line-height:2;">
            {t.typoList.map((item) => <li set:html={`• ${item}`}></li>)}
          </ul>
        </div>
        <div class="card card--tc">
          <h4 style="color:var(--tc-600);margin-bottom:.75rem;">{t.compLib}</h4>
          <div class="grid-2" style="color:var(--gray-700);line-height:2;">
            {t.compList.map((item) => <div>• {item}</div>)}
          </div>
        </div>
      </div>

      <div style="border-radius:.75rem;overflow:hidden;box-shadow:0 4px 16px rgba(0,0,0,.08);border:1px solid var(--tc-200);">
        <img src={`${base}/images/0b95846d03ebc76f20426131ffb2211bb3cddfbf.avif`} alt="Jodify Design System Components" style="width:100%;height:auto;" />
      </div>
    </div>

    <!-- 04. Validation & Testing -->
    <div class="cs-section reveal">
      <div class="cs-section-title">
        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/>
        </svg>
        <span>{t.testingTitle}</span>
      </div>
      <p style="color:var(--gray-700);margin-bottom:1.5rem;line-height:1.7;">{t.testingIntro}</p>

      <div class="card card--highlight" style="margin-bottom:1.5rem;">
        <h3 style="color:var(--tc-600);margin-bottom:.35rem;">{t.scenario}</h3>
        <p style="color:var(--gray-700);">{t.scenarioBody}</p>
      </div>

      <h3 style="color:var(--tc-600);margin-bottom:1rem;">{t.testingTasks}</h3>
      <div style="display:flex;flex-direction:column;gap:1rem;margin-bottom:2rem;">
        <div class="card card--tc">
          <h4 style="color:var(--tc-600);margin-bottom:.35rem;">{t.task1Title}</h4>
          <p style="color:var(--gray-700);margin-bottom:.25rem;" set:html={t.task1Obj}></p>
          <p style="color:var(--gray-700);" set:html={t.task1Success}></p>
        </div>
        <div class="card card--tc">
          <h4 style="color:var(--tc-600);margin-bottom:.35rem;">{t.task2Title}</h4>
          <p style="color:var(--gray-700);margin-bottom:.25rem;" set:html={t.task2Obj}></p>
          <p style="color:var(--gray-700);" set:html={t.task2Success}></p>
        </div>
      </div>

      <h3 style="color:var(--tc-600);margin-bottom:1rem;">{t.results}</h3>
      <div class="card card--tc" style="margin-bottom:1rem;">
        <p style="color:var(--gray-700);margin-bottom:1rem;" set:html={t.successRate}></p>
        <div style="margin-bottom:1rem;">
          <h4 style="color:var(--tc-600);margin-bottom:.35rem;">{t.task1ResTitle}</h4>
          <p style="color:#16a34a;margin-bottom:.25rem;" set:html={t.task1ResLabel}></p>
          <p style="color:var(--gray-700);">{t.task1ResBody}</p>
        </div>
        <div>
          <h4 style="color:var(--tc-600);margin-bottom:.35rem;">{t.task2ResTitle}</h4>
          <p style="color:#16a34a;margin-bottom:.25rem;" set:html={t.task2ResLabel}></p>
          <p style="color:var(--gray-700);">{t.task2ResBody}</p>
        </div>
      </div>

      <div class="card card--highlight" style="margin-bottom:1.5rem;">
        <h4 style="color:var(--tc-600);margin-bottom:.35rem;">{t.timeOnTask}</h4>
        <p style="color:var(--gray-700);line-height:1.7;" set:html={t.timeOnTaskBody}></p>
      </div>

      <h3 style="color:var(--tc-600);margin-bottom:1rem;">{t.qualitative}</h3>
      <div style="display:flex;flex-direction:column;gap:.75rem;margin-bottom:1.5rem;">
        {t.quotes.map((quote) => (
          <div class="card card--tc"><p style="color:var(--gray-700);">{quote}</p></div>
        ))}
      </div>

      <div class="card" style="background:#f0fdf4;border-color:#bbf7d0;">
        <h4 style="color:var(--tc-600);margin-bottom:.35rem;">{t.conclusion}</h4>
        <p style="color:var(--gray-700);line-height:1.7;">{t.conclusionBody}</p>
      </div>
    </div>

    <!-- 05. Final Solution -->
    <div class="cs-section reveal">
      <div class="cs-section-title">
        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5"/>
          <path d="M9 18h6"/><path d="M10 22h4"/>
        </svg>
        <span>{t.finalTitle}</span>
      </div>
      <p style="color:var(--gray-700);line-height:1.7;margin-bottom:1.5rem;">{t.finalBody}</p>

      <div class="card card--highlight" style="margin-bottom:1.5rem;">
        <h3 style="color:var(--tc-600);margin-bottom:1rem;">{t.keyFeatures}</h3>
        <div class="grid-2">
          <div>
            <h4 style="color:var(--tc-600);margin-bottom:.35rem;">{t.feat1Title}</h4>
            <p style="color:var(--gray-700);">{t.feat1Desc}</p>
          </div>
          <div>
            <h4 style="color:var(--tc-600);margin-bottom:.35rem;">{t.feat2Title}</h4>
            <p style="color:var(--gray-700);">{t.feat2Desc}</p>
          </div>
          <div>
            <h4 style="color:var(--tc-600);margin-bottom:.35rem;">{t.feat3Title}</h4>
            <p style="color:var(--gray-700);">{t.feat3Desc}</p>
          </div>
          <div>
            <h4 style="color:var(--tc-600);margin-bottom:.35rem;">{t.feat4Title}</h4>
            <p style="color:var(--gray-700);">{t.feat4Desc}</p>
          </div>
        </div>
      </div>
      <div style="border-radius:.75rem;overflow:hidden;box-shadow:0 4px 16px rgba(0,0,0,.08);border:1px solid var(--tc-200);">
        <img src={`${base}/images/ef2a41b240065b6ab8681a246a0e10cc2594985a.webp`} alt="Jodify App Final Screens" style="width:100%;height:auto;" />
      </div>
    </div>

    <!-- Impact -->
    <div class="cs-section reveal">
      <div class="cs-section-title">
        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M16 7h6v6"/><path d="m22 7-8.5 8.5-5-5L2 17"/>
        </svg>
        <span>{t.impactTitle}</span>
      </div>
      <div class="card" style="background:linear-gradient(135deg,var(--tc-50),var(--tc-100));border-color:var(--tc-200);padding:2rem;">
        <div class="grid-3">
          <div style="text-align:center;">
            <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                 style="color:var(--tc-600);margin:0 auto 1rem;">
              <path d="M10 14.66v1.626a2 2 0 0 1-.976 1.696A5 5 0 0 0 7 21.978"/>
              <path d="M14 14.66v1.626a2 2 0 0 0 .976 1.696A5 5 0 0 1 17 21.978"/>
              <path d="M18 9h1.5a1 1 0 0 0 0-5H18"/>
              <path d="M4 22h16"/>
              <path d="M6 9a6 6 0 0 0 12 0V3a1 1 0 0 0-1-1H7a1 1 0 0 0-1 1z"/>
              <path d="M6 9H4.5a1 1 0 0 1 0-5H6"/>
            </svg>
            <div style="color:var(--tc-600);margin-bottom:.5rem;font-weight:600;">{t.imp1Label}</div>
            <p style="color:var(--gray-600);font-size:.875rem;">{t.imp1Desc}</p>
          </div>
          <div style="text-align:center;">
            <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                 style="color:var(--tc-600);margin:0 auto 1rem;">
              <rect width="14" height="20" x="5" y="2" rx="2" ry="2"/>
              <path d="M12 18h.01"/>
            </svg>
            <div style="color:var(--tc-600);margin-bottom:.5rem;font-weight:600;">{t.imp2Label}</div>
            <p style="color:var(--gray-600);font-size:.875rem;">{t.imp2Desc}</p>
          </div>
          <div style="text-align:center;">
            <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                 style="color:var(--tc-600);margin:0 auto 1rem;">
              <path d="M11 21.73a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73z"/>
              <path d="M12 22V12"/>
              <polyline points="3.29 7 12 12 20.71 7"/>
              <path d="m7.5 4.27 9 5.15"/>
            </svg>
            <div style="color:var(--tc-600);margin-bottom:.5rem;font-weight:600;">{t.imp3Label}</div>
            <p style="color:var(--gray-600);font-size:.875rem;">{t.imp3Desc}</p>
          </div>
        </div>
      </div>
    </div>

    <!-- CTA -->
    <div class="cs-section reveal" style="text-align:center;padding-bottom:4rem;">
      <a href={t.behanceUrl} target="_blank" rel="noopener noreferrer" class="btn btn--primary btn--lg">
        <span>{tShared.viewFullCaseStudy}</span>
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
        </svg>
      </a>
    </div>
  </div>
</BaseLayout>
